    {
      "title": "Error Budget Burn Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Ratio of API server errors to total requests. A value above 1 means the error budget is burning faster than allowed.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "pointSize": 5, "showPoints": "never", "thresholdsStyle": { "mode": "line" } },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 2 }
            ]
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        {
          "expr": "(sum(rate(apiserver_request_total{code=~\"5..\"}[1h])) / sum(rate(apiserver_request_total[1h]))) / 0.001",
          "legendFormat": "1h burn rate (SLO 99.9%)",
          "refId": "A"
        },
        {
          "expr": "(sum(rate(apiserver_request_total{code=~\"5..\"}[6h])) / sum(rate(apiserver_request_total[6h]))) / 0.001",
          "legendFormat": "6h burn rate (SLO 99.9%)",
          "refId": "B"
        }
      ]
    }
