          "legendFormat": "",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "kube_pod_container_status_waiting{namespace=~\"$namespace\", pod=~\"$pod\"}",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "C"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "endpoint": true, "instance": true, "job": true, "service": true, "uid": true },
            "renameByName": {
              "namespace": "Namespace",
              "pod": "Pod",
              "container": "Container",
              "Value #A": "Restarts",
              "Value #B": "Running",
              "Value #C": "Waiting"
