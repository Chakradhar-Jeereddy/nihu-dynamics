## 3. Investigate Scanning Issues

### Check scan job status in Harbor
```sql
-- Scan job queue and status
SELECT id, status, status_code, creation_time, update_time
FROM task
WHERE execution_id IN (
    SELECT id FROM execution WHERE vendor_type = 'SCAN'
)
ORDER BY creation_time DESC
LIMIT 50;

-- Count scan jobs by status
SELECT status, count(*)
FROM task
WHERE execution_id IN (
    SELECT id FROM execution WHERE vendor_type = 'SCAN'
)
GROUP BY status;

-- Stuck/pending scan executions
SELECT id, vendor_type, status, trigger, start_time, end_time
FROM execution
WHERE vendor_type = 'SCAN'
  AND status IN ('Running', 'Pending', 'Scheduled')
ORDER BY start_time DESC;

-- Failed scans in the last 24h
SELECT id, status, status_code, status_message, creation_time
FROM task
WHERE execution_id IN (
    SELECT id FROM execution WHERE vendor_type = 'SCAN'
)
  AND status = 'Error'
  AND creation_time > now() - interval '24 hours'
ORDER BY creation_time DESC
LIMIT 20;
```

### Clean up stuck scan jobs
```sql
-- Mark stale Running/Pending scan tasks as Error (older than 2 hours)
UPDATE task SET status = 'Error', status_message = 'Manually cleaned - stuck'
WHERE status IN ('Running', 'Pending')
  AND creation_time < now() - interval '2 hours'
  AND execution_id IN (
    SELECT id FROM execution WHERE vendor_type = 'SCAN'
  );

-- Also update the parent executions
UPDATE execution SET status = 'Error'
WHERE vendor_type = 'SCAN'
  AND status IN ('Running', 'Pending')
  AND start_time < now() - interval '2 hours';
```

