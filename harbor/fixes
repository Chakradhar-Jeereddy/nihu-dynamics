## 10. Additional Diagnostic Queries

### Per-project blob usage (find which projects consume most space)
```sql
SELECT p.name AS project_name,
       count(pb.blob_id) AS blob_count,
       pg_size_pretty(sum(b.size)) AS total_size
FROM project_blob pb
JOIN blob b ON pb.blob_id = b.id
JOIN project p ON pb.project_id = p.project_id
GROUP BY p.name
ORDER BY sum(b.size) DESC;
```

### Per-repository artifact count (find repos with most images)
```sql
SELECT r.name AS repository_name,
       count(a.id) AS artifact_count,
       min(a.push_time) AS oldest_push,
       max(a.push_time) AS newest_push
FROM artifact a
JOIN repository r ON a.repository_id = r.repository_id
GROUP BY r.name
ORDER BY artifact_count DESC
LIMIT 20;
```

### Largest blobs (find oversized layers)
```sql
SELECT digest, pg_size_pretty(size) AS blob_size, creation_time
FROM blob
ORDER BY size DESC
LIMIT 20;
```

### Scan report bloat (vulnerability data accumulates fast)
```sql
SELECT
    pg_size_pretty(pg_total_relation_size('scan_report')) AS scan_report_size,
    count(*) AS total_reports,
    count(*) FILTER (WHERE create_time < now() - interval '30 days') AS old_reports
FROM scan_report;

-- Delete old scan reports (> 30 days, artifacts may have been rescanned since)
DELETE FROM scan_report
WHERE create_time < now() - interval '30 days';

VACUUM ANALYZE scan_report;
```

### Index health check
```sql
SELECT indexrelname, idx_scan, idx_tup_read, idx_tup_fetch,
       pg_size_pretty(pg_relation_size(indexrelid)) AS index_size
FROM pg_stat_user_indexes
WHERE schemaname = 'public'
ORDER BY pg_relation_size(indexrelid) DESC
LIMIT 20;
```

### Lock contention (if GC seems stuck)
```sql
SELECT blocked_locks.pid AS blocked_pid,
       blocked_activity.usename AS blocked_user,
       blocking_locks.pid AS blocking_pid,
       blocking_activity.usename AS blocking_user,
       blocked_activity.query AS blocked_statement,
       blocking_activity.query AS blocking_statement
FROM pg_catalog.pg_locks blocked_locks
JOIN pg_catalog.pg_stat_activity blocked_activity ON blocked_activity.pid = blocked_locks.pid
JOIN pg_catalog.pg_locks blocking_locks
    ON blocking_locks.locktype = blocked_locks.locktype
    AND blocking_locks.database IS NOT DISTINCT FROM blocked_locks.database
    AND blocking_locks.relation IS NOT DISTINCT FROM blocked_locks.relation
    AND blocking_locks.page IS NOT DISTINCT FROM blocked_locks.page
    AND blocking_locks.tuple IS NOT DISTINCT FROM blocked_locks.tuple
    AND blocking_locks.virtualxid IS NOT DISTINCT FROM blocked_locks.virtualxid
    AND blocking_locks.transactionid IS NOT DISTINCT FROM blocked_locks.transactionid
    AND blocking_locks.classid IS NOT DISTINCT FROM blocked_locks.classid
    AND blocking_locks.objid IS NOT DISTINCT FROM blocked_locks.objid
    AND blocking_locks.objsubid IS NOT DISTINCT FROM blocked_locks.objsubid
    AND blocking_locks.pid != blocked_locks.pid
JOIN pg_catalog.pg_stat_activity blocking_activity ON blocking_activity.pid = blocking_locks.pid
WHERE NOT blocked_locks.granted;
```

